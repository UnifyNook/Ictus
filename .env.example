# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest

# PostgreSQL（docker compose 以 POSTGRES_* 拼接 artex 容器运行时的 ARTEX_PG_DSN：
# postgres://${POSTGRES_USER:-artex}:${POSTGRES_PASSWORD}@${POSTGRES_HOST:-postgres}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-artex}?sslmode=disable）
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# LLM 在 UI 的「LLM 配置」页填写并入库，不读取环境变量。
